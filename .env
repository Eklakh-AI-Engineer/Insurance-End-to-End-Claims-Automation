# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME="Insurance Claims Automation API"
DEBUG=false
SECRET_KEY=change-me-in-production

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insurance_db

# ── AI / LLM ─────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── ML Model Paths ────────────────────────────────────────────────────────────
FRAUD_MODEL_PATH=../ml/models/fraud_xgb.pkl
ISO_FOREST_PATH=../ml/models/iso_forest.pkl
PAYOUT_MODEL_PATH=../ml/models/payout_model.pkl

# ── Upload ────────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── Settlement Thresholds ─────────────────────────────────────────────────────
FRAUD_THRESHOLD=0.2
PAYOUT_MATCH_THRESHOLD=0.90

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
